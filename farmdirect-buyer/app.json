{
  "expo": {
    "name": "FarmDirect Buyer",
    "slug": "farmdirect-buyer",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "farmdirect",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.farmdirect.buyer",
      "infoPlist": {
        "NSCameraUsageDescription": "FarmDirect uses the camera for AI produce scanning.",
        "NSPhotoLibraryUsageDescription": "FarmDirect uses your photo library when you choose a produce image to scan."
      }
    },
    "android": {
      "package": "com.farmdirect.buyer",
      "usesCleartextTraffic": true,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-camera",
      "expo-image-picker",
      "expo-status-bar"
    ],
    "extra": {
      "eas": {
        "projectId": "7b961699-840f-4ebc-8851-a6532a081526"
      }
    }
  }
}
